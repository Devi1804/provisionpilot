# Auto-generated by ProvisionPilot. Do not edit by hand.
Vagrant.configure("2") do |config|
  config.vm.box = "perk/ubuntu-2204-arm64"

  vms = [
{% for vm in vms %}
    { name: "{{ vm.name }}", role: "{{ vm.role }}", ssh_port: {{ 50022 + loop.index0 }} },
{% endfor %}
  ]

  vms.each do |vm|
    config.vm.define vm[:name] do |node|
      node.vm.hostname = vm[:name]
      node.vm.provider "qemu" do |qe|
        qe.arch = "aarch64"
        qe.machine = "virt,accel=hvf,highmem=on"
        qe.cpu = "host"
        qe.smp = "cpus={{ cpus }},sockets=1,cores={{ cpus }},threads=1"
        qe.memory = "{{ memory_mb }}"
        qe.net_device = "virtio-net-pci"
        qe.ssh_port = vm[:ssh_port]
      end
    end
  end
end